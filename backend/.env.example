# ============================================================
# AI-Wrong 后端环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# 所有相对路径均相对 backend/ 目录解析。
# ============================================================

# --- 数据库（SQLite，默认存于 backend/data/wrongbook.db）---
# DATABASE_URL=sqlite:///./data/wrongbook.db

# --- 向量库（ChromaDB 持久化目录）---
# CHROMA_DIR=./data/chroma

# --- 向量嵌入模式：local（默认，本地轻量）| api（调用外部 API）---
EMBEDDING_MODE=local

# --- 大模型（OpenAI 兼容，如 DeepSeek / 通义千问）---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 未配置 Key 时保持 false，系统降级为「仅存 OCR 文本」入库
LLM_ENABLED=false

# --- 上传图片保存目录 ---
# UPLOAD_DIR=./data/uploads

# --- 服务端口 ---
BACKEND_PORT=8000

# --- 可选：日志级别 ---
# LOG_LEVEL=INFO
